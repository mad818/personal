#!/usr/bin/env node
/* eslint-disable no-console */
import fs from "node:fs";
import path from "node:path";

const root = process.cwd();

function fail(msg) {
  console.error(`x runtime-experiment-improver: ${msg}`);
  process.exit(1);
}

const contracts = path.join(root, "lib", "runtimeExperimentContracts.ts");
const ledger = path.join(root, "lib", "runtimeExperimentLedger.ts");

if (!fs.existsSync(contracts)) fail("lib/runtimeExperimentContracts.ts is missing");
if (!fs.existsSync(ledger)) fail("lib/runtimeExperimentLedger.ts is missing");

const contractsSrc = fs.readFileSync(contracts, "utf8");
const ledgerSrc = fs.readFileSync(ledger, "utf8");

if (!contractsSrc.includes("RuntimeExperiment")) {
  fail("runtimeExperimentContracts.ts missing RuntimeExperiment type");
}
if (!ledgerSrc.includes("baseline") && !ledgerSrc.includes("variant")) {
  fail("runtimeExperimentLedger.ts missing baseline/variant comparison logic");
}

console.log("ok runtime-experiment-improver (contracts and ledger verified)");
