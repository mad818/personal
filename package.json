{
  "name": "aegis-vector",
  "private": true,
  "description": "Homefront: local-first command-and-intelligence workspace for markets, cyber, recon, and operator AI on web and desktop. Free-first, self-hosted, and interactive by design.",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "node scripts/clean-next.mjs && next build",
    "start": "node scripts/start-runtime.mjs",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "seed": "node -r dotenv/config ./scripts/seed.mjs",
    "design:lint": "node node_modules/@google/design.md/dist/index.js lint DESIGN.md",
    "design:generate": "node scripts/generate-design-md-runtime.mjs",
    "design:check": "node scripts/generate-design-md-runtime.mjs --check && npm run design:lint",
    "arpg:art:generate": "node scripts/generate-arpg-original-art.mjs",
    "arpg:illustrated:generate": "node scripts/generate-arpg-illustrated-assets.mjs",
    "arpg:assets:import": "node scripts/import-arpg-real-assets.mjs",
    "arpg:asset-candidates:check": "node scripts/validate-arpg-asset-candidates.mjs",
    "arpg:visual:check": "node scripts/validate-arpg-visual-direction.mjs",
    "arpg:visual-briefs:check": "node scripts/validate-arpg-visual-briefs.mjs",
    "arpg:content:check": "node scripts/validate-arpg-content.mjs",
    "arpg:assets:check": "node scripts/validate-arpg-assets.mjs",
    "arpg:production:check": "node scripts/validate-arpg-production-readiness.mjs",
    "arpg:visual-replacements:check": "node scripts/validate-arpg-visual-replacements.mjs",
    "arpg:tools:check": "node scripts/validate-arpg-content-tools.mjs",
    "arpg:save:check": "node scripts/validate-arpg-save-readiness.mjs",
    "arpg:balance:check": "node scripts/validate-arpg-balance-readiness.mjs",
    "arpg:release:check": "node scripts/validate-arpg-release-readiness.mjs",
    "arpg:presentation:check": "node scripts/validate-arpg-presentation-cues.mjs",
    "check:path-collisions": "node scripts/check-path-collisions.js",
    "eval:agent-runtime": "node scripts/eval-agent-runtime.js",
    "eval:agent-runtime:record": "node scripts/eval-agent-runtime.js --record --min-score 85",
    "eval:agent-runtime:ci": "node scripts/eval-agent-runtime.js --min-score 85 --min-category safety=80 --min-category reliability=80 --min-category ux=70 --min-category observability=70",
    "eval:runtime-experiment": "node scripts/eval-runtime-experiment.js",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "publication:safety:check": "node scripts/validate-publication-safety.mjs",
    "security-scan": "node scripts/security-scan.js",
    "security:tauri": "node scripts/check-tauri-security.mjs",
    "security:boundaries": "node scripts/validate-security-boundaries.mjs",
    "dependency:risk:posture": "node scripts/dependency-risk-posture.mjs",
    "dependency:risk:check": "node scripts/dependency-risk-posture.mjs --check",
    "validate:infra-hardening": "node scripts/validate-infra-hardening.mjs",
    "route:integrity": "node scripts/route-integrity.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "release:diagnostics:capture": "node scripts/release-diagnostics-capture.mjs",
    "readiness:rollup": "node scripts/readiness-rollup.mjs",
    "autonomy:self-work": "node scripts/autonomy-self-work.mjs",
    "infra:hardening:audit": "node scripts/infra-hardening-audit.mjs",
    "dependabot:audit:classify": "node scripts/dependabot-security-audit.mjs",
    "auth:regression": "node scripts/auth-regression.mjs",
    "auth:e2e": "playwright test -c playwright.auth.config.ts",
    "hq:e2e": "playwright test -c playwright.auth.config.ts tests/e2e/hq-shell.spec.ts",
    "route:e2e": "playwright test -c playwright.auth.config.ts tests/e2e/route-contract.spec.ts tests/e2e/landing-public.spec.ts",
    "tabs:e2e": "playwright test -c playwright.auth.config.ts tests/e2e/tab-surfaces.spec.ts",
    "runtime:consistency": "node scripts/runtime-consistency.mjs",
    "runtime:fresh-proof": "node scripts/fresh-runtime-proof.mjs",
    "runtime:launch:3100": "node scripts/runtime-launch-3100.mjs",
    "runtime:proof:3100": "node scripts/runtime-proof-check.mjs",
    "runtime:stop:3100": "node scripts/runtime-stop-3100.mjs",
    "dev:direct:3100": "node scripts/dev-direct-3100.mjs",
    "vehicle:readiness:check": "node scripts/validate-vehicle-readiness.mjs",
    "surface:polish:check": "node scripts/validate-secondary-surface-polish.mjs",
    "smoothness:check": "node scripts/validate-smoothness-guardrails.mjs",
    "offline:local:check": "node scripts/validate-offline-local-readiness.mjs",
    "phone:access:check": "node scripts/validate-phone-access-readiness.mjs",
    "phone:lan:check": "node scripts/validate-phone-lan-readiness.mjs",
    "phone:lan:start": "node scripts/phone-lan-start.mjs",
    "phone:acceptance:capture": "node scripts/phone-acceptance-capture.mjs",
    "release:checksums": "node scripts/generate-desktop-checksums.mjs",
    "repo:sync:health": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/repo-sync-health-check.ps1",
    "git:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/git-with-acl-repair.ps1",
    "repo:branches:audit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/branch-cleanup-report.ps1",
    "orbit:next": "node scripts/orbit.js",
    "audit:full": "npm run verify && node scripts/audit.js --verified",
    "verify": "npm run design:check && npm run arpg:content:check && npm run arpg:asset-candidates:check && npm run arpg:assets:check && npm run arpg:visual:check && npm run arpg:visual-briefs:check && npm run arpg:visual-replacements:check && npm run arpg:production:check && npm run arpg:tools:check && npm run arpg:save:check && npm run arpg:balance:check && npm run arpg:release:check && npm run arpg:presentation:check && npm run offline:local:check && npm run phone:access:check && npm run phone:lan:check && npm run surface:polish:check && npm run smoothness:check && npm run type-check && npm run lint && npm run check:path-collisions && npm run publication:safety:check && npm run security-scan && npm run security:tauri && npm run security:boundaries && npm run dependency:risk:check && npm run validate:infra-hardening",
    "verify:full": "npm run verify && npm run format:check",
    "handoff:write": "node scripts/generate-handoff.js --write",
    "handoff:check": "node scripts/generate-handoff.js --check",
    "handoff:sync": "node scripts/sync-handoff-loop.js",
    "handoff:pull": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/git-with-acl-repair.ps1 pull",
    "desktop:build-runtime": "node scripts/clean-next.mjs && next build",
    "desktop:start-runtime": "node scripts/start-runtime.mjs",
    "desktop:tauri:dev": "node scripts/ensure-tauri-icon.mjs && cd desktop/src-tauri && npx --yes --package @tauri-apps/cli tauri dev",
    "desktop:tauri:build": "node scripts/ensure-tauri-icon.mjs && cd desktop/src-tauri && npx --yes --package @tauri-apps/cli tauri build",
    "format:write": "prettier --write \"{app,lib,components}/**/*.{ts,tsx,mdx}\" --cache",
    "format:check": "prettier --check \"{app,lib,components}**/*.{ts,tsx,mdx}\" --cache",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@types/leaflet": "^1.9.21",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "date-fns": "^3.6.0",
    "focus-trap-react": "^10.2.3",
    "framer-motion": "^11.2.12",
    "geist": "^1.3.0",
    "leaflet": "^1.9.4",
    "nanoid": "^5.0.7",
    "next": "^15.5.15",
    "next-themes": "^0.4.6",
    "phaser": "^4.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-intersection-observer": "^9.10.3",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^8.0.7",
    "react-syntax-highlighter": "^15.5.0",
    "react-textarea-autosize": "^8.5.3",
    "recharts": "^3.8.0",
    "remark-gfm": "^3.0.1",
    "remark-math": "^5.1.1",
    "sonner": "^1.5.0",
    "three": "^0.180.0",
    "usehooks-ts": "^3.1.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@google/design.md": "^0.1.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.13",
    "@types/d3-scale": "^4.0.8",
    "@types/node": "^20.14.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/parser": "^7.14.1",
    "autoprefixer": "^10.4.27",
    "dotenv": "^16.4.5",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.5.15",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-tailwindcss": "^3.14.0",
    "husky": "^9.1.7",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.2",
    "yaml": "^2.8.3"
  },
  "packageManager": "pnpm@8.6.3"
}
