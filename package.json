{
  "name": "aegis-vector",
  "private": true,
  "description": "Aegis Vector: local-first command-and-intelligence workspace for markets, cyber, recon, and operator AI on web and desktop. Free-first, self-hosted, and interactive by design.",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "node scripts/build-runtime.mjs",
    "start": "node scripts/start-runtime.mjs",
    "runtime:heal": "node scripts/runtime-auto-heal.mjs",
    "hq:open": "node scripts/runtime-auto-heal.mjs --open --path /hq",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "seed": "node -r dotenv/config ./scripts/seed.mjs",
    "check:path-collisions": "node scripts/check-path-collisions.js",
    "check:route-policy": "node scripts/check-route-policy.mjs",
    "check:protected-cache": "node scripts/check-protected-api-cache.mjs",
    "check:connector-inputs": "node scripts/check-connector-inputs.mjs",
    "check:connector-responses": "node scripts/check-connector-responses.mjs",
    "eval:scheduler-efficiency": "node scripts/eval-scheduler-efficiency.js",
    "eval:scheduler-efficiency:record": "node scripts/eval-scheduler-efficiency.js --record",
    "eval:forecast": "node scripts/eval-forecast-readiness.js",
    "eval:forecast:record": "node scripts/eval-forecast-readiness.js --record",
    "eval:agent-runtime": "node scripts/eval-agent-runtime.js",
    "eval:agent-runtime:record": "node scripts/eval-agent-runtime.js --record --min-score 85",
    "eval:agent-runtime:ci": "node scripts/eval-agent-runtime.js --min-score 85 --min-category safety=80 --min-category reliability=80 --min-category ux=70 --min-category observability=70",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "security-scan": "node scripts/security-scan.js",
    "security-scan:staged": "node scripts/security-scan.js --staged",
    "security-scan:history": "node scripts/security-history-audit.mjs",
    "security:tauri": "node scripts/check-tauri-security.mjs",
    "route:integrity": "node scripts/route-integrity.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "release:boundary": "pwsh -File scripts/release-boundary.ps1",
    "release:boundary:capture": "pwsh -File scripts/release-boundary.ps1 -Mode capture",
    "auth:regression": "node scripts/auth-regression.mjs",
    "auth:e2e": "playwright test -c playwright.auth.config.ts",
    "hq:e2e": "playwright test -c playwright.auth.config.ts tests/e2e/hq-shell.spec.ts",
    "route:e2e": "playwright test -c playwright.auth.config.ts tests/e2e/route-contract.spec.ts",
    "tabs:e2e": "playwright test -c playwright.auth.config.ts tests/e2e/tab-surfaces.spec.ts",
    "runtime:consistency": "node scripts/runtime-consistency.mjs",
    "runtime:fresh-proof": "node scripts/fresh-runtime-proof.mjs",
    "vehicle:bridge:stub": "node scripts/vehicle-bridge-stub.mjs",
    "release:checksums": "node scripts/generate-desktop-checksums.mjs",
    "orbit:next": "node scripts/orbit.js",
    "audit:full": "npm run health && npm run check:stale",
    "launch:gate": "pwsh -File scripts/launch-gate.ps1",
    "launch:gate:target": "pwsh -File scripts/launch-gate-target.ps1",
    "verify": "npm run type-check && npm run lint && npm run check:path-collisions && npm run check:route-policy && npm run check:protected-cache && npm run check:connector-inputs && npm run check:connector-responses && npm run security-scan && npm run security:tauri",
    "verify:agents": "node scripts/verify-agents.js --skip-agents",
    "verify:full": "npm run verify && npm run format:check",
    "handoff:write": "node scripts/generate-handoff.js --write",
    "handoff:check": "node scripts/generate-handoff.js --check",
    "handoff:sync": "node scripts/sync-handoff-loop.js",
    "handoff:pull": "node scripts/handoff-pull.mjs",
    "desktop:build-runtime": "node scripts/build-runtime.mjs",
    "desktop:start-runtime": "node scripts/start-runtime.mjs",
    "desktop:tauri:dev": "node scripts/ensure-tauri-icon.mjs && cd desktop/src-tauri && npx --yes --package @tauri-apps/cli tauri dev",
    "desktop:tauri:build": "node scripts/ensure-tauri-icon.mjs && cd desktop/src-tauri && npx --yes --package @tauri-apps/cli tauri build",
    "format:write": "prettier --write \"{app,lib,components}/**/*.{ts,tsx,mdx}\" --cache",
    "format:check": "prettier --check \"{app,lib,components}**/*.{ts,tsx,mdx}\" --cache",
    "prepare": "husky",
    "test": "vitest run",
    "test:unit": "vitest run __tests__",
    "test:watch": "vitest",
    "analyze": "ANALYZE=true next build",
    "health": "npm run type-check && npm run lint && npm run check:path-collisions && npm run check:route-policy && npm run check:protected-cache && npm run check:connector-inputs && npm run check:connector-responses && npm run security-scan",
    "check:stale": "node scripts/check-stale-todos.mjs",
    "check:unused": "knip",
    "check:cycles": "madge --circular --extensions ts,tsx app lib components store hooks",
    "dev:clean": "node -e \"const{execSync}=require('child_process');try{execSync('npx kill-port 3000',{stdio:'ignore'})}catch(e){}\" && node scripts/clean-next.mjs && npm run dev"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.12",
    "@types/leaflet": "^1.9.21",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "date-fns": "^3.6.0",
    "focus-trap-react": "^10.2.3",
    "framer-motion": "^11.2.12",
    "geist": "^1.3.0",
    "leaflet": "^1.9.4",
    "nanoid": "^5.0.7",
    "next": "14.2.35",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intersection-observer": "^9.10.3",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^8.0.7",
    "react-syntax-highlighter": "^15.5.0",
    "react-textarea-autosize": "^8.5.3",
    "recharts": "^3.8.0",
    "remark-gfm": "^3.0.1",
    "remark-math": "^5.1.1",
    "sonner": "^1.5.0",
    "three": "^0.180.0",
    "usehooks-ts": "^3.1.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.0",
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "^1.6.0",
    "vitest": "^1.6.0",
    "@tailwindcss/typography": "^0.5.13",
    "@types/d3-scale": "^4.0.8",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/parser": "^7.14.1",
    "autoprefixer": "^10.4.27",
    "dotenv": "^16.4.5",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-tailwindcss": "^3.14.0",
    "husky": "^9.1.7",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.2",
    "knip": "^5.0.0",
    "madge": "^8.0.0"
  },
  "packageManager": "pnpm@8.6.3"
}
