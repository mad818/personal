{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus",
  "identifier": "com.nexus.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:build-runtime && npm run desktop:start-runtime",
    "beforeBuildCommand": "npm run desktop:build-runtime",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../../.next/standalone"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://127.0.0.1:*; frame-src 'none'; object-src 'none';"
    },
    "windows": [
      {
        "title": "Nexus",
        "width": 1400,
        "height": 920,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": ["app", "dmg", "msi"],
    "macOS": {
      "signingIdentity": null
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  }
}
