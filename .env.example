# ── AI Providers ──────────────────────────────────────────────────────────────
# The server tries providers in order: Ollama → Groq → OpenRouter → Google → MiniMax → Anthropic → OpenAI
# Only the keys you add will be attempted. Missing keys are skipped silently.

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Groq (fast inference, free tier) — https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (multi-model gateway) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google AI (Gemini) — https://aistudio.google.com/apikey
GOOGLE_AI_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# MiniMax (OpenAI-compatible) — https://platform.minimax.io
MINIMAX_API_KEY=

# Ollama local endpoint (default: http://localhost:11434/v1/chat/completions)
# OLLAMA_ENDPOINT=http://localhost:11434/v1/chat/completions
# OLLAMA_API_KEY=ollama

# ── Internal Auth ─────────────────────────────────────────────────────────────
# Protects /api/* routes — set any random string
NEXUS_TOKEN=

# ── Token Budget ──────────────────────────────────────────────────────────────
# Max output tokens per request (default: 2048, max allowed: 8192)
# NEXUS_MAX_TOKENS=2048
# NEXUS_TOOL_POLICY_MODE=strict
# NEXUS_HIGH_RISK_WRITES_REQUIRE_APPROVAL=true
# NEXUS_RUNTIME_EVAL_MIN_SCORE=85
# NEXUS_RUNTIME_EVAL_MIN_SAFETY=80
# NEXUS_RUNTIME_EVAL_MIN_RELIABILITY=80
# NEXUS_RUNTIME_EVAL_MIN_UX=70
# NEXUS_RUNTIME_EVAL_MIN_OBSERVABILITY=70
# NEXUS_RUNTIME_EVAL_COOLDOWN_MIN=30
# NEXUS_RUNTIME_EVAL_FRESHNESS_MIN=240

# ── Data APIs ─────────────────────────────────────────────────────────────────
# All optional — app degrades gracefully when keys are absent

# CoinGecko Demo — https://www.coingecko.com/en/api
COINGECKO_KEY=

# Finnhub (stock quotes) — https://finnhub.io
FINNHUB_KEY=

# NVD (CVE feed) — https://nvd.nist.gov/developers/request-an-api-key
NVD_KEY=

# The Guardian (news) — https://open-platform.theguardian.com
GUARDIAN_KEY=

# FRED (economic data) — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_KEY=

# AlienVault OTX (threat intel) — https://otx.alienvault.com
OTX_KEY=

# AISstream (live ship tracking) — https://aisstream.io
AISSTREAM_KEY=

# NASA FIRMS (fire hotspots) — https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# Firecrawl (web scraper) — https://firecrawl.dev
FIRECRAWL_KEY=

# Brave Search — https://api.search.brave.com
BRAVE_SEARCH_KEY=

# ── IDE / local LLM routers (optional — not used by Nexus server code) ─────
# Nexus reads provider keys above via lib/ai.ts. These vars are for tools that
# sit *outside* the app: Cursor, Claude Code, UncommonRoute, factory-cursor-bridge.
# Set them in Cursor Settings → Models, or your shell profile — not required in .env.local.
#
# UncommonRoute (OpenAI-compatible): https://github.com/CommonstackAI/UncommonRoute
#   OPENAI_BASE_URL=http://127.0.0.1:8403/v1
#   OPENAI_API_KEY=not-needed
# UncommonRoute (Anthropic-style clients):
#   ANTHROPIC_BASE_URL=http://127.0.0.1:8403
#   ANTHROPIC_API_KEY=not-needed
#
# factory-cursor-bridge (multi-provider BYOK for Cursor; often needs a public tunnel):
#   https://github.com/0xSero/factory-cursor-bridge
#   Cursor: Override OpenAI Base URL → your tunnel URL; custom models use fx- prefix per their README.
