# ── AI Providers ──────────────────────────────────────────────────────────────
# The server tries providers in order: Ollama → Groq → OpenRouter → Google → MiniMax → Anthropic → OpenAI
# Only the keys you add will be attempted. Missing keys are skipped silently.

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Groq (fast inference, free tier) — https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (multi-model gateway) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google AI (Gemini) — https://aistudio.google.com/apikey
GOOGLE_AI_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# MiniMax (OpenAI-compatible) — https://platform.minimax.io
MINIMAX_API_KEY=

# Ollama local endpoint (default: http://localhost:11434/v1/chat/completions)
# OLLAMA_ENDPOINT=http://localhost:11434/v1/chat/completions
# OLLAMA_API_KEY=ollama

# ── Internal Auth ─────────────────────────────────────────────────────────────
# Protects /api/* routes — set any random string
NEXUS_TOKEN=

# ── Token Budget ──────────────────────────────────────────────────────────────
# Max output tokens per request (default: 2048, max allowed: 8192)
# NEXUS_MAX_TOKENS=2048
# NEXUS_TOOL_POLICY_MODE=strict
# NEXUS_HIGH_RISK_WRITES_REQUIRE_APPROVAL=true
# Route gating profile: isolated (default), internal, connected
# NEXUS_NETWORK_MODE=isolated
# Enable high-risk route class (/api/tools, /api/ai, /api/mqtt, etc.) only when explicitly needed
# NEXUS_ENABLE_HIGH_RISK_TOOLS=false
# Free-use safeguard: keep paid AI providers blocked unless explicitly opted in
# NEXUS_ALLOW_PAID_APIS=false
# Deployment profile: local-dev (default), web-self-hosted, desktop-secure
# NEXUS_DEPLOYMENT_PROFILE=local-dev
#
# Fully free phone access via this desktop while it stays on:
# NEXUS_PHONE_LAN_ENABLED=false
# NEXUS_PHONE_LAN_PORT=3100
# NEXUS_NETWORK_MODE=isolated
# NEXUS_ALLOW_PAID_APIS=false
# Start intentionally with: npm run phone:lan:start
#
# Optional hosted phone access via VPS/Coolify while the desktop is off:
# This can involve infrastructure costs outside Homefront and is not the default free path.
# NEXUS_DEPLOYMENT_PROFILE=web-self-hosted
# NEXUS_NETWORK_MODE=internal
# NEXUS_ENABLE_HIGH_RISK_TOOLS=false
# NEXUS_HIGH_RISK_WRITES_REQUIRE_APPROVAL=true
# NEXUS_ALLOW_PAID_APIS=false
# Add one free/BYOK AI key above, such as GROQ_API_KEY, GOOGLE_AI_KEY, or OPENROUTER_API_KEY.
#
# Build metadata for status/diagnostics payloads
# NEXUS_BUILD_CHANNEL=dev
# NEXUS_BUILD_VERSION=local-dev
# Optional per-connector overrides (JSON booleans). Example: {"news":true,"flights":false}
# NEXUS_CONNECTOR_POLICY_JSON=
# Desktop sidecar execution gate (Tauri command boundary)
# NEXUS_TAURI_ENABLE_SIDECAR=false
# Sidecar binary paths (only used when sidecar gate is enabled)
# NEXUS_SIDECAR_PYTHON_OSINT=/absolute/path/to/osint-sidecar
# NEXUS_SIDECAR_PYTHON_VISION=/absolute/path/to/vision-sidecar
# NEXUS_RUNTIME_EVAL_MIN_SCORE=85
# NEXUS_RUNTIME_EVAL_MIN_SAFETY=80
# NEXUS_RUNTIME_EVAL_MIN_RELIABILITY=80
# NEXUS_RUNTIME_EVAL_MIN_UX=70
# NEXUS_RUNTIME_EVAL_MIN_OBSERVABILITY=70
# NEXUS_RUNTIME_EVAL_COOLDOWN_MIN=30
# NEXUS_RUNTIME_EVAL_FRESHNESS_MIN=240
# Non-default experiment flags
# NEXUS_EXPERIMENT_TIMESFM_SPIKE=false

# ── Optional local acceleration plane ─────────────────────────────────────────
# Both runtimes are disabled by default and must be started separately.
# Loopback is required unless the tailnet confirmation is explicitly enabled.
# NEXUS_LOCAL_ACCELERATION_ALLOW_TAILNET=false
# Companion bridge always binds to loopback and stores its private ledger in .nexus/.
# NEXUS_LOCAL_ACCELERATION_PYTHON=
# NEXUS_LOCAL_ACCELERATION_HOST=127.0.0.1
# NEXUS_LOCAL_ACCELERATION_PORT=5052
# NEXUS_LOCAL_ACCELERATION_STATE_DIR=.nexus/local-acceleration
# NEXUS_LOCAL_ACCELERATION_OLLAMA_URL=http://127.0.0.1:11434
# NEXUS_LOCAL_ACCELERATION_EMBED_MODEL=nomic-embed-text
# NEXUS_LOCAL_ACCELERATION_EMBED_MODE=auto
# NEXUS_LOCAL_ACCELERATION_HASH_DIMENSION=384
# NEXUS_LOCAL_ACCELERATION_VECTOR_BACKEND=auto
#
# TurboVec local vector service (MIT upstream runtime)
# NEXUS_TURBOVEC_ENABLED=false
# NEXUS_TURBOVEC_ENDPOINT=http://127.0.0.1:5052
# NEXUS_TURBOVEC_BIT_WIDTH=4
# NEXUS_TURBOVEC_TIMEOUT_MS=4000
#
# TurboQuant local GPU runtime (separate GPL-3.0 vLLM runtime)
# NEXUS_TURBOQUANT_ENABLED=false
# NEXUS_TURBOQUANT_ENDPOINT=http://127.0.0.1:5052
# NEXUS_TURBOQUANT_OPENAI_ENDPOINT=http://127.0.0.1:8000/v1/chat/completions
# NEXUS_TURBOQUANT_MODEL=local-turboquant
# NEXUS_TURBOQUANT_MODE=off
# NEXUS_TURBOQUANT_KEY_BITS=3
# NEXUS_TURBOQUANT_VALUE_BITS=4
# NEXUS_TURBOQUANT_TIMEOUT_MS=8000
# Companion bridge only: reviewed commands remain disabled without both controls.
# NEXUS_TURBOQUANT_ROOT=
# NEXUS_LOCAL_ACCELERATION_ALLOW_EXEC=false
# NEXUS_TURBOQUANT_COMMAND_TIMEOUT_SECONDS=900

# ── Data APIs ─────────────────────────────────────────────────────────────────
# All optional — app degrades gracefully when keys are absent

# CoinGecko Demo — https://www.coingecko.com/en/api
COINGECKO_KEY=

# Finnhub (stock quotes) — https://finnhub.io
FINNHUB_KEY=

# NVD (CVE feed) — https://nvd.nist.gov/developers/request-an-api-key
NVD_KEY=

# The Guardian (news) — https://open-platform.theguardian.com
GUARDIAN_KEY=

# FRED (economic data) — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_KEY=

# AlienVault OTX (threat intel) — https://otx.alienvault.com
OTX_KEY=

# AISstream (live ship tracking) — https://aisstream.io
AISSTREAM_KEY=

# NASA FIRMS (fire hotspots) — https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# Firecrawl (web scraper) — https://firecrawl.dev
FIRECRAWL_KEY=

# Brave Search — https://api.search.brave.com
BRAVE_SEARCH_KEY=

# ── IDE / local LLM routers (optional — not used by Nexus server code) ─────
# Nexus reads provider keys above via lib/ai.ts. These vars are for tools that
# sit *outside* the app: Cursor, Claude Code, UncommonRoute, factory-cursor-bridge.
# Set them in Cursor Settings → Models, or your shell profile — not required in .env.local.
#
# UncommonRoute (OpenAI-compatible): https://github.com/CommonstackAI/UncommonRoute
#   OPENAI_BASE_URL=http://127.0.0.1:8403/v1
#   OPENAI_API_KEY=not-needed
# UncommonRoute (Anthropic-style clients):
#   ANTHROPIC_BASE_URL=http://127.0.0.1:8403
#   ANTHROPIC_API_KEY=not-needed
#
# factory-cursor-bridge (multi-provider BYOK for Cursor; often needs a public tunnel):
#   https://github.com/0xSero/factory-cursor-bridge
#   Cursor: Override OpenAI Base URL → your tunnel URL; custom models use fx- prefix per their README.

# ── Release smoke tooling (optional) ──────────────────────────────────────────
# Override when testing a remote deployment with `npm run release:smoke`
# NEXUS_RELEASE_BASE_URL=http://127.0.0.1:3000
