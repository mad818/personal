# ── AI Providers ──────────────────────────────────────────────────────────────
# Free-tier chain (auto, no flag needed — just set the keys you have):
#   Ollama → Cerebras → Groq → SambaNova → NVIDIA → Hyperbolic → Together
#   → SiliconFlow → ZAI → iFlow → DeepInfra → Fireworks → Scaleway → DashScope
#   → HuggingFace → Codestral → Google AI (Gemma) → Cloudflare → Perplexity
#
# Paid providers activate only when NEXUS_ALLOW_PAID_APIS=true:
#   OpenRouter → Google (Gemini) → MiniMax → Anthropic → OpenAI
#
# The chain tries each provider in order; missing keys + failed providers are
# skipped silently via circuit breaker. No flag or restart required.
# All endpoints + model IDs: github.com/vava-nessa/free-coding-models

# ── LOCAL ──────────────────────────────────────────────────────────────────────
# Ollama local (default: http://localhost:11434/v1/chat/completions)
# OLLAMA_ENDPOINT=http://localhost:11434/v1/chat/completions
# OLLAMA_API_KEY=ollama

# ── FREE TIER — SPEED FIRST ────────────────────────────────────────────────────
# Cerebras | ~1750 tok/s | Qwen3 235B (S+ 70.0%) | cloud.cerebras.ai
CEREBRAS_API_KEY=

# Groq | LPU inference | Qwen3 32B (A+ 50.0%) | console.groq.com/keys
GROQ_API_KEY=

# SambaNova | DeepSeek V3.2 (S+ 73.1%) | cloud.sambanova.ai
SAMBANOVA_API_KEY=

# ── FREE TIER — HIGH QUALITY ───────────────────────────────────────────────────
# NVIDIA NIM | 40 RPM | Qwen3 Coder 480B (S+ 70.6%) | build.nvidia.com
NVIDIA_API_KEY=

# Hyperbolic | $1 credits | Qwen3 Coder 480B (S+ 70.6%) | app.hyperbolic.ai
HYPERBOLIC_API_KEY=

# Together AI | Kimi K2.5 (S+ 76.8%) | api.together.ai/settings/api-keys
TOGETHER_API_KEY=

# SiliconFlow | Qwen3 Coder 480B (S+ 70.6%) | cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=

# ZAI / z.ai | GLM-5 (S+ 77.8% — highest free model score) | open.z.ai
ZAI_API_KEY=

# iFlow | Unlimited requests | DeepSeek V3.2 (S+ 73.1%) | key expires 7 days | platform.iflow.cn
IFLOW_API_KEY=

# ── FREE TIER — BULK / SPECIALTY ──────────────────────────────────────────────
# DeepInfra | 200 concurrent | Qwen3 235B (S+ 70.0%) | deepinfra.com/login
DEEPINFRA_API_KEY=

# Fireworks AI | $1 credits | Qwen3 235B (S+ 70.0%) | fireworks.ai
FIREWORKS_API_KEY=

# Scaleway | 1M free tokens | Devstral 2 123B (S+ 72.2%) | console.scaleway.com/iam/api-keys
SCALEWAY_API_KEY=

# Alibaba DashScope | 1M tokens/model 90 days | Qwen3 Coder 480B (S+ 70.6%) | modelstudio.console.alibabacloud.com
DASHSCOPE_API_KEY=

# Hugging Face | ~$0.10 monthly credits | DeepSeek V3 (S 62.0%) | huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Mistral Codestral | Free | 2000 req/day | code-specialist | codestral.mistral.ai
CODESTRAL_API_KEY=

# Google AI Studio | Free Gemma 3 27B | 14.4K req/day | aistudio.google.com/apikey
# Also used by the paid "google" provider for Gemini 2.0 Flash (requires NEXUS_ALLOW_PAID_APIS=true)
GOOGLE_AI_KEY=

# Cloudflare Workers AI | 10K neurons/day | Kimi K2.5 (S+ 76.8%) | dash.cloudflare.com
# Both vars required — missing either one skips the provider silently
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Perplexity | Search-grounded | sonar-reasoning (A 45.0%) | perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# ── PAID TIER (require NEXUS_ALLOW_PAID_APIS=true) ────────────────────────────
# OpenRouter | Multi-model gateway | qwen3-coder:free default | openrouter.ai/keys
OPENROUTER_API_KEY=

# MiniMax | OpenAI-compatible | platform.minimax.io
MINIMAX_API_KEY=

# Anthropic Claude | Prompt caching enabled | console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI GPT | platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Internal Auth ─────────────────────────────────────────────────────────────
# Protects /api/* routes — set any random string
NEXUS_TOKEN=

# ── Token Budget ──────────────────────────────────────────────────────────────
# Max output tokens per request (default: 2048, max allowed: 8192)
# NEXUS_MAX_TOKENS=2048
# NEXUS_TOOL_POLICY_MODE=strict
# NEXUS_HIGH_RISK_WRITES_REQUIRE_APPROVAL=true
# Route gating profile: isolated (default), internal, connected
# NEXUS_NETWORK_MODE=isolated
# Enable high-risk route class (/api/tools, /api/ai, /api/mqtt, etc.) only when explicitly needed
# NEXUS_ENABLE_HIGH_RISK_TOOLS=false
# Activate paid providers (openrouter, google/gemini, minimax, anthropic, openai)
# NEXUS_ALLOW_PAID_APIS=false
# Optional: enable queued provider-native Anthropic batching for scheduled missions.
# Free-first installs should leave this off and stay on the internal batch lane.
# NEXUS_ENABLE_ANTHROPIC_NATIVE_BATCHES=false
# Deployment profile: local-dev (default), web-self-hosted, desktop-secure
# NEXUS_DEPLOYMENT_PROFILE=local-dev
# Build metadata for status/diagnostics payloads
# NEXUS_BUILD_CHANNEL=dev
# NEXUS_BUILD_VERSION=local-dev
# Optional per-connector overrides (JSON booleans). Example: {"news":true,"flights":false}
# NEXUS_CONNECTOR_POLICY_JSON=
# Desktop sidecar execution gate (Tauri command boundary)
# NEXUS_TAURI_ENABLE_SIDECAR=false
# Sidecar binary paths (only used when sidecar gate is enabled)
# NEXUS_SIDECAR_PYTHON_OSINT=/absolute/path/to/osint-sidecar
# NEXUS_SIDECAR_PYTHON_VISION=/absolute/path/to/vision-sidecar
# NEXUS_RUNTIME_EVAL_MIN_SCORE=85
# NEXUS_RUNTIME_EVAL_MIN_SAFETY=80
# NEXUS_RUNTIME_EVAL_MIN_RELIABILITY=80
# NEXUS_RUNTIME_EVAL_MIN_UX=70
# NEXUS_RUNTIME_EVAL_MIN_OBSERVABILITY=70
# NEXUS_RUNTIME_EVAL_COOLDOWN_MIN=30
# NEXUS_RUNTIME_EVAL_FRESHNESS_MIN=240
# Non-default experiment flags
# NEXUS_EXPERIMENT_TIMESFM_SPIKE=false

# ── Vehicle passive bridge stub (optional, future hardware day) ───────────────
# Use with `npm run vehicle:bridge:stub` when you want a local passive-bridge harness
# before real Pixhawk / ArduPilot hardware arrives, or as a smoke test on arrival day.
# NEXUS_VEHICLE_BRIDGE_URL=http://127.0.0.1:3000/api/vehicle/telemetry
# NEXUS_VEHICLE_BRIDGE_ID=pixhawk-passive-bridge
# NEXUS_VEHICLE_BRIDGE_LABEL=Pixhawk passive bridge
# NEXUS_VEHICLE_BRIDGE_AUTHORITY=read_only
# NEXUS_VEHICLE_BRIDGE_INTERVAL_MS=2000
# NEXUS_VEHICLE_TRANSPORT=usb_serial
# NEXUS_VEHICLE_BAUD_RATE=57600
# NEXUS_VEHICLE_PORT_HINT=COM7 / /dev/ttyACM0

# ── Data APIs ─────────────────────────────────────────────────────────────────
# All optional — app degrades gracefully when keys are absent

# CoinGecko Demo — https://www.coingecko.com/en/api
COINGECKO_KEY=

# Finnhub (stock quotes) — https://finnhub.io
FINNHUB_KEY=

# NVD (CVE feed) — https://nvd.nist.gov/developers/request-an-api-key
NVD_KEY=

# The Guardian (news) — https://open-platform.theguardian.com
GUARDIAN_KEY=

# FRED (economic data) — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_KEY=

# AlienVault OTX (threat intel) — https://otx.alienvault.com
OTX_KEY=

# Have I Been Pwned — https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# VirusTotal — https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# Shodan — https://account.shodan.io/
SHODAN_API_KEY=

# AISstream (live ship tracking) — https://aisstream.io
AISSTREAM_KEY=

# NASA FIRMS (fire hotspots) — https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# Firecrawl (web scraper) — https://firecrawl.dev
FIRECRAWL_KEY=

# Brave Search — https://api.search.brave.com
BRAVE_SEARCH_KEY=

# ── IDE / local LLM routers (optional — not used by Nexus server code) ─────
# Nexus reads provider keys above via lib/ai.ts. These vars are for tools that
# sit *outside* the app: Cursor, Claude Code, UncommonRoute, factory-cursor-bridge.
# Set them in Cursor Settings → Models, or your shell profile — not required in .env.local.
#
# UncommonRoute (OpenAI-compatible): https://github.com/CommonstackAI/UncommonRoute
#   OPENAI_BASE_URL=http://127.0.0.1:8403/v1
#   OPENAI_API_KEY=not-needed
# UncommonRoute (Anthropic-style clients):
#   ANTHROPIC_BASE_URL=http://127.0.0.1:8403
#   ANTHROPIC_API_KEY=not-needed
#
# factory-cursor-bridge (multi-provider BYOK for Cursor; often needs a public tunnel):
#   https://github.com/0xSero/factory-cursor-bridge
#   Cursor: Override OpenAI Base URL → your tunnel URL; custom models use fx- prefix per their README.

# ── Release smoke tooling (optional) ──────────────────────────────────────────
# Override when testing a remote deployment with `npm run release:smoke`
# NEXUS_RELEASE_BASE_URL=http://127.0.0.1:3000
