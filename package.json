{
  "name": "aegis-vector",
  "private": true,
  "description": "Aegis Vector: local-first command-and-intelligence workspace for markets, cyber, recon, and operator AI on web and desktop. Free-first, self-hosted, and interactive by design.",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "node scripts/clean-next.mjs && next build",
    "start": "node scripts/start-runtime.mjs",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "seed": "node -r dotenv/config ./scripts/seed.mjs",
    "check:path-collisions": "node scripts/check-path-collisions.js",
    "eval:agent-runtime": "node scripts/eval-agent-runtime.js",
    "eval:agent-runtime:record": "node scripts/eval-agent-runtime.js --record --min-score 85",
    "eval:agent-runtime:ci": "node scripts/eval-agent-runtime.js --min-score 85 --min-category safety=80 --min-category reliability=80 --min-category ux=70 --min-category observability=70",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "security-scan": "node scripts/security-scan.js",
    "security:tauri": "node scripts/check-tauri-security.mjs",
    "route:integrity": "node scripts/route-integrity.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "auth:regression": "node scripts/auth-regression.mjs",
    "auth:e2e": "playwright test -c playwright.auth.config.ts",
    "hq:e2e": "playwright test -c playwright.auth.config.ts tests/e2e/hq-shell.spec.ts",
    "route:e2e": "playwright test -c playwright.auth.config.ts tests/e2e/route-contract.spec.ts tests/e2e/landing-public.spec.ts",
    "tabs:e2e": "playwright test -c playwright.auth.config.ts tests/e2e/tab-surfaces.spec.ts",
    "runtime:consistency": "node scripts/runtime-consistency.mjs",
    "runtime:fresh-proof": "node scripts/fresh-runtime-proof.mjs",
    "release:checksums": "node scripts/generate-desktop-checksums.mjs",
    "orbit:next": "node scripts/orbit.js",
    "audit:full": "node scripts/audit.js",
    "verify": "npm run type-check && npm run lint && npm run check:path-collisions && npm run security-scan && npm run security:tauri",
    "verify:full": "npm run verify && npm run format:check",
    "handoff:write": "node scripts/generate-handoff.js --write",
    "handoff:check": "node scripts/generate-handoff.js --check",
    "handoff:sync": "node scripts/sync-handoff-loop.js",
    "handoff:pull": "git pull",
    "desktop:build-runtime": "node scripts/clean-next.mjs && next build",
    "desktop:start-runtime": "node scripts/start-runtime.mjs",
    "desktop:tauri:dev": "node scripts/ensure-tauri-icon.mjs && cd desktop/src-tauri && npx --yes --package @tauri-apps/cli tauri dev",
    "desktop:tauri:build": "node scripts/ensure-tauri-icon.mjs && cd desktop/src-tauri && npx --yes --package @tauri-apps/cli tauri build",
    "format:write": "prettier --write \"{app,lib,components}/**/*.{ts,tsx,mdx}\" --cache",
    "format:check": "prettier --check \"{app,lib,components}**/*.{ts,tsx,mdx}\" --cache",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@types/leaflet": "^1.9.21",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "date-fns": "^3.6.0",
    "focus-trap-react": "^10.2.3",
    "framer-motion": "^11.2.12",
    "geist": "^1.3.0",
    "leaflet": "^1.9.4",
    "nanoid": "^5.0.7",
    "next": "^15.5.15",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-intersection-observer": "^9.10.3",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^8.0.7",
    "react-syntax-highlighter": "^15.5.0",
    "react-textarea-autosize": "^8.5.3",
    "recharts": "^3.8.0",
    "remark-gfm": "^3.0.1",
    "remark-math": "^5.1.1",
    "sonner": "^1.5.0",
    "three": "^0.180.0",
    "usehooks-ts": "^3.1.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.13",
    "@types/d3-scale": "^4.0.8",
    "@types/node": "^20.14.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/parser": "^7.14.1",
    "autoprefixer": "^10.4.27",
    "dotenv": "^16.4.5",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.5.15",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-tailwindcss": "^3.14.0",
    "husky": "^9.1.7",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.2"
  },
  "packageManager": "pnpm@8.6.3"
}
